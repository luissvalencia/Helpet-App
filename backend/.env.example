PORT=3000

# Ruta al archivo de credenciales de la cuenta de servicio de Firebase.
# Descargar desde: Firebase Console > Project settings > Service accounts > Generate new private key
# Guardar el archivo fuera del control de versiones, por ejemplo en backend/serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

FIREBASE_STORAGE_BUCKET=helpet-app-503fd.firebasestorage.app

# URL del ai-service (FastAPI). US-12: se llama de forma async al crear un reporte.
AI_SERVICE_URL=http://localhost:8001

# Sprint 4 (US-19): clave compartida para autenticar llamadas servidor-a-servidor
# desde ai-service a POST /notificaciones/coincidencia. Debe coincidir con
# INTERNAL_API_KEY en ai-service/.env.
INTERNAL_API_KEY=cambia-esta-clave

# Sprint 5 (US-23): solo informativo para GET /admin/metricas. Debe coincidir
# con SIMILARITY_THRESHOLD en ai-service/app/config.py (no se lee de ahí,
# son procesos separados).
SIMILARITY_THRESHOLD=0.145

# Endurecimiento post-Sprint-7: lista separada por comas de orígenes permitidos
# por CORS (ej. https://admin.helpet.app,https://otro.dominio). Si se deja sin
# setear, el backend acepta cualquier origen (comportamiento histórico) — la
# app Flutter no envía Origin y no le aplica CORS, esto solo importa si se
# agrega un cliente web.
CORS_ORIGIN=

# Nivel de logging de winston (error, warn, info, debug). Default: info.
LOG_LEVEL=info
