{
  "name": "helpet-backend",
  "version": "1.0.0",
  "description": "API REST de Helpet (autenticación, perfiles, reportes de mascotas)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "set-admin": "node scripts/setAdminClaim.js",
    "lint": "eslint .",
    "test": "jest --config jest.config.js",
    "test:integration": "cross-env FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 GCLOUD_PROJECT=demo-helpet jest --config jest.integration.config.js --runInBand --forceExit",
    "test:integration:ci": "firebase emulators:exec --project demo-helpet --only firestore,auth \"npm run test:integration\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^12.3.1",
    "helmet": "^8.2.0",
    "morgan": "^1.10.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "firebase-tools": "^15.20.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
